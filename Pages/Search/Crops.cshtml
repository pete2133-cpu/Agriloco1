@page
@model agriloco.api.Pages.Search.CropsModel
@using Agriloco.Api.Dtos
@{
    ViewData["Title"] = "Find local food";
}

<div class="search-hero"><p class="eyebrow">From farms near you</p><h1>Find local food.</h1><p class="section-intro">Explore crops, varieties and ways to buy directly from local farms.</p></div>

<form method="get" class="search-form">
    <div>
        <label for="Category">Crop or product</label><br />
        <input placeholder="e.g. Apples" id="Category" name="Category" value="@Model.Category" list="categoryList" />
        <datalist id="categoryList">
            @foreach (var c in Model.CategorySuggestions)
            {
                <option value="@c"></option>
            }
        </datalist>
    </div>

    <div>
        <label for="Variety">Variety</label><br />
        <input placeholder="Any variety" id="Variety" name="Variety" value="@Model.Variety" />
    </div>

    <div>
        <label for="OfferingType">How to buy</label><br />
        <select id="OfferingType" name="OfferingType">
            <option value="" selected="@(string.IsNullOrEmpty(Model.OfferingType) ? "selected" : null)">Any</option>
            <option value="PickYourOwn" selected="@(Model.OfferingType == "PickYourOwn" ? "selected" : null)">Pick your own</option>
            <option value="ReadyPicked" selected="@(Model.OfferingType == "ReadyPicked" ? "selected" : null)">Ready picked</option>
                        <option value="FarmStore" selected="@(Model.OfferingType == "FarmStore" ? "selected" : null)">Farm shop</option>
            <option value="Wholesale" selected="@(Model.OfferingType == "Wholesale" ? "selected" : null)">Wholesale</option>
            <option value="RetailPartner" selected="@(Model.OfferingType == "RetailPartner" ? "selected" : null)">Retail partner</option>
            <option value="FarmersMarket" selected="@(Model.OfferingType == "FarmersMarket" ? "selected" : null)">Farmers market</option>
            <option value="Frozen" selected="@(Model.OfferingType == "Frozen" ? "selected" : null)">Frozen</option>
        </select>
    </div>

    <div>
        <label for="Availability">Availability</label><br />
        <select id="Availability" name="Availability">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Availability) ? "selected" : null)">Any</option>
            <option value="Available" selected="@(Model.Availability == "Available" ? "selected" : null)">Available</option>
            <option value="Coming Soon" selected="@(Model.Availability == "Coming Soon" ? "selected" : null)">Coming soon</option>
            <option value="NotAvailable" selected="@(Model.Availability == "NotAvailable" ? "selected" : null)">Unavailable</option>
        </select>
    </div>

    <div>
        <button type="submit">Find food</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-danger" role="alert">
        @Model.Message
    </div>
}

@if (Model.Results.Any())
{
    <h2>@Model.Results.Count matching @(Model.Results.Count == 1 ? "listing" : "listings")</h2>
    <div class="result-grid">
        @foreach (var c in Model.Results)
        {
            <article class="result-card">
                <span class="badge" data-status="@c.Availability">@(c.Availability == "NotAvailable" ? "Unavailable" : string.IsNullOrWhiteSpace(c.Availability) ? "Check with farm" : c.Availability)</span>
                <h2>@c.Category</h2>
                @if (!string.IsNullOrWhiteSpace(c.Variety)) { <p>@c.Variety</p> }
                <p><strong>@(Model.FarmNames.GetValueOrDefault(c.FarmId, "Local farm"))</strong></p>
                @if (Model.FarmAddresses.TryGetValue(c.FarmId, out var address) && !string.IsNullOrWhiteSpace(address)) { <p class="text-muted">@address</p> }
                <p class="text-muted">@(string.IsNullOrWhiteSpace(c.SalesMethods) ? "Contact the farm for buying options" : c.SalesMethods)</p>
                <a class="btn" asp-page="/Public/Farm" asp-route-id="@c.FarmId">View farm &amp; details →</a>
            </article>
        }
    </div>
    <!-- ✅ NEW: Map shows farms from search results (if they have lat/lng) -->
    <div style="margin-top:10px;">
        <h3 style="margin: 0 0 8px 0;">Map of Results</h3>
        <div id="resultsMap" style="width:100%;max-width:1100px;height:420px;border:1px solid #ddd;border-radius:12px;overflow:hidden;"></div>

        @if (Model.MapPoints == null || Model.MapPoints.Count == 0)
        {
            <div class="text-muted" style="margin-top:8px;">
                Some farms may not appear on the map. You can still view every listing above.
            </div>
        }
    </div>
}
else if (string.IsNullOrEmpty(Model.Message))
{
    <div class="empty-state"><h2>No matching products</h2><p>Try another crop or variety, or broaden your availability filters.</p><a asp-page="/Search/Crops">Clear filters and browse all food</a></div>
}

@section Scripts {
    <!-- Leaflet LOCAL (recommended) -->
    <link rel="stylesheet" href="/lib/leaflet/leaflet.css" />
    <script src="/lib/leaflet/leaflet.js"></script>

    <script>
        (function () {
            const mapEl = document.getElementById("resultsMap");
            if (!mapEl) return;

            // farmIds from results
            const farmIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.Results.Select(r => r.FarmId).Distinct().ToList()
                    ));

        // Default view (Toronto-ish)
        const map = L.map("resultsMap", { scrollWheelZoom: false }).setView([43.6532, -79.3832], 7);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            if (!farmIds || farmIds.length === 0) return;

            const bounds = [];

            async function loadFarm(farmId) {
                const resp = await fetch(`/api/farms/${farmId}/public_single`);
                if (!resp.ok) return null;
                return await resp.json();
            }

            (async function () {
                // show a simple status if you want (optional)
                // console.log("Loading farm locations...");

                const farms = await Promise.all(farmIds.map(loadFarm));

                for (const f of farms) {
                    if (!f) continue;

                    const lat = f.latitude;
                    const lng = f.longitude;

                    if (typeof lat !== "number" || typeof lng !== "number") continue;
                    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) continue;

                    const name = f.name || (`Farm #${f.id}`);
                    const addr = f.address ? `<br><small>${f.address}</small>` : "";

                    const m = L.marker([lat, lng]).addTo(map);
                    m.bindPopup(`${name}${addr}`);

                    bounds.push([lat, lng]);
                }

                if (bounds.length === 1) {
                    map.setView(bounds[0], 11);
                } else if (bounds.length > 1) {
                    map.fitBounds(bounds, { padding: [30, 30] });
                }
            })();
        })();
    </script>
}