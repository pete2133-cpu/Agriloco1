@page
@model Agriloco1.Pages.Farmer.DashboardModel
@{
    ViewData["Title"] = "Farm Dashboard";
    Layout = "/Pages/Shared/_DashboardLayout.cshtml";
}

@if (TempData["AvailabilityEmailMessage"] is string emailMessage)
{
    <p class="alert alert-info" role="status">@emailMessage</p>
}


<div class="dashboard-wrap">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="dashboard-header">

        <div>

            <h1 class="dashboard-title">
                Farmer Dashboard
            </h1>

            <div class="dashboard-subtitle">
                @Model.FarmName
            </div>

        </div>



    </div>

    <!-- ============================================================
         AVAILABILITY CONTROL
         ============================================================ -->

    <section class="availability-heading"><div><h2>Crop Availability</h2><p>Set what's available and where it's sold. Changes save automatically.</p></div>        <div class="dashboard-actions">

            <a class="action-button primary-button"
               asp-page="/Farmer/Add"
               asp-route-farmId="@Model.FarmId">
                + Add Crop / Variety
            </a>

            <a class="action-button"
               asp-page="/Farmer/Inventory/ProcessRecords"
               asp-route-farmId="@Model.FarmId">
                Record Activity
            </a>

            <a class="action-button"
               href="@Url.Content("~/Public/Farm")?id=@Model.FarmId">
                View public farm
            </a>

        </div></section>
    <nav class="crop-sections" aria-label="Jump to crop section">
        <a href="#availability-list">All <span>@Model.FarmDefinitions.Count</span></a>
        @foreach (var root in Model.FarmDefinitions.Where(x => Model.GetDepth(x) == 0))
        {
            <a href="#definition-@root.Id">@root.DisplayName</a>
        }
    </nav>
    <div class="control-panel" id="availability-list">

        @if (Model.FarmDefinitions.Count == 0)
        {
            <div class="empty-panel">

                <h3>
                    No crops or products have been added yet.
                </h3>

                <p>
                    Add a crop or product,
                    then control availability
                    from this page.
                </p>

                <a class="action-button primary-button"
                   asp-page="/Farmer/Add"
                   asp-route-farmId="@Model.FarmId">
                    Add your first crop or product
                </a>

            </div>
        }
        else
        {
            <div class="control-header">

                <div>
                    Crop / Variety / Row
                </div>

                <div>
                    Availability Status
                </div>

                <div>
                    Sales Channels
                </div>

                <div style="text-align:center;">
                    Actions / Public
                </div>

            </div>

            @foreach (var item
                    in Model.FarmDefinitions)
            {
                var depth =
                Model.GetDepth(item);

                var leftPadding =
                8 + (depth * 28);

                var hasChildren = Model.FarmDefinitions.Any(x => x.ParentFarmDefinitionId == item.Id);
                var statusClass = item.IsPathway ? "neutral" : new[] { "Available", "Peak Season", "Limited Availability", "Late Season" }.Contains(item.Status) ? "available" : item.Status == "Coming Soon" ? "soon" : new[] { "Unavailable", "Out of Season", "Sold Out", "End of Season" }.Contains(item.Status) ? "unavailable" : "neutral";
                <div id="definition-@item.Id" data-depth="@depth" data-parent="@item.ParentFarmDefinitionId" data-status="@statusClass" class="definition-row @(depth == 0 ? "category-root" : "") @(item.DefinitionType == "Location" ? "location-row" : "")">

                    <!-- ITEM -->

                    <div class="definition-info" style="--depth:@depth;">

                        <span class="crop-avatar" aria-hidden="true">
                            @if (Model.ImageSources.TryGetValue(item.Id, out var imageSource))
                            {
                                <img class="definition-thumbnail" src="@Agriloco.Api.Services.DefinitionImages.Url(Model.FarmId, imageSource, false)" alt="" loading="lazy" decoding="async" />
                            }
                            <svg><use href="#dash-leaf"/></svg>
                        </span>
                        <div class="definition-copy"><span class="definition-name">

                            @if (depth > 0)
                            {
                                <span>
                                    ↳
                                </span>
                            }

                            @item.DisplayName

                        </span>

                        @if (!string.IsNullOrWhiteSpace(
                                        item.DefinitionType))
                        {
                            <span class="definition-type">
                                @item.DefinitionType
                            </span>
                        }

                        @if (hasChildren)
                        {
                            <button type="button" class="tree-toggle" data-definition="@item.Id" aria-expanded="true" aria-label="Collapse @item.DisplayName children">Collapse <span aria-hidden="true">⌃</span></button>
                        }
                        </div>
                    </div>

                    <!-- STATUS -->

                    <div>

                        <form method="post"
                              asp-page-handler="Status">

                            <input type="hidden"
                                   name="farmId"
                                   value="@Model.FarmId" />

                            <input type="hidden"
                                   name="farmDefinitionId"
                                   value="@item.Id" />

                            <label class="mobile-label" for="status-@item.Id">Availability</label>
                            <select id="status-@item.Id" aria-label="Availability for @item.DisplayName" class="status-select"
                                    name="status" disabled="@item.IsPathway"
                                    onchange="this.form.submit()">

                                @if (item.IsPathway) { <option value="" selected>Not applicable</option> }
                                @foreach (var status
                                                        in Model.StatusOptions)
                                {
                                    if (item.Status == status)
                                    {
                                        <option value="@status"
                                                selected>
                                            @status
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@status">
                                            @status
                                        </option>
                                    }
                                }

                            </select>

                        </form>

                    </div>

                    <!-- AVAILABLE THROUGH -->

                    <div><span class="mobile-label">Available through</span><div class="channel-list">

                        @foreach (var channel
                                        in Model.AvailabilityChannels)
                        {
                            var enabled =
                            Model.IsChannelEnabled(
                            item.Id,
                            channel.Id);

                            <form method="post"
                                  asp-page-handler="Channel"
                                  style="display:inline;">

                                <input type="hidden"
                                       name="farmId"
                                       value="@Model.FarmId" />

                                <input type="hidden"
                                       name="farmDefinitionId"
                                       value="@item.Id" />

                                <input type="hidden"
                                       name="availabilityChannelId"
                                       value="@channel.Id" />

                                <input type="hidden"
                                       name="isEnabled"
                                       value="@(enabled ? "false" : "true")" />

                                <label class="channel-option">

                                    <input type="checkbox"
                                           aria-label="@channel.Name for @item.DisplayName" checked="@enabled" disabled="@item.IsPathway"
                                           onchange="this.form.submit()" />

                                    @channel.Name

                                </label>

                            </form>
                        }

                    </div>

                    </div>
                    <!-- PUBLIC -->

                    <div class="public-control">
                        <div class="row-actions"><a asp-page="/Farmer/MarketDetails" asp-route-farmId="@Model.FarmId" asp-route-itemId="@item.Id">Market Details</a></div>
                        <div class="row-actions">
                            <a asp-page="/Farmer/Add" asp-route-farmId="@Model.FarmId" asp-route-editId="@item.Id">Edit</a>
                            <a asp-page="/Farmer/Inventory/ProcessRecords" asp-route-farmId="@Model.FarmId">Record</a>
                        </div>

                        <form method="post"
                              asp-page-handler="Public">

                            <input type="hidden"
                                   name="farmId"
                                   value="@Model.FarmId" />

                            <input type="hidden"
                                   name="farmDefinitionId"
                                   value="@item.Id" />

                            <input type="hidden"
                                   name="isPublic"
                                   value="@(item.IsPublic ? "false" : "true")" />

                            <label class="visibility-label"><input type="checkbox"
                                   checked="@item.IsPublic"
                                   onchange="this.form.submit()" /> Visible</label>

                        </form>

                    </div>

                </div>
            }
        }

    </div>

    <div class="autosave-note">
        Changes save automatically. Enabling a child also enables its parents. Disabling a parent turns off its descendants.
        Enabling a parent does not enable its children. Visibility is managed separately.
    </div>

    <!-- ============================================================
         FARM BASEMAP
         ============================================================ -->

    <details class="basemap-panel" open="@(!ViewData.ModelState.IsValid)">
        <summary class="basemap-summary">Farm basemap setup</summary>
        <div class="basemap-body">

        <div class="basemap-header">

            <h2>
                Farm Basemap
            </h2>

            <div class="basemap-help">
                Upload an image of the farm that will be used
                as the background for the interactive map.
                JPG, PNG and WebP images are supported.
            </div>

        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="upload-error">

                @foreach (var error
                            in ViewData.ModelState.Values
                            .SelectMany(x => x.Errors))
                {
                    <div>
                        @error.ErrorMessage
                    </div>
                }

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(
                Model.MapImageUrl))
        {
            <div class="basemap-preview">

                <img src="@Model.MapImageUrl"
                     alt="@Model.FarmName basemap" />

            </div>
        }
        else
        {
            <div class="basemap-preview">

                <div class="basemap-empty">
                    No basemap has been uploaded yet.
                </div>

            </div>
        }

        <form method="post"
              enctype="multipart/form-data"
              asp-page-handler="Basemap">

            <input type="hidden"
                   name="farmId"
                   value="@Model.FarmId" />

            <div class="basemap-upload">

                <input class="basemap-file"
                       type="file"
                       asp-for="BasemapUpload"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                <button type="submit"
                        class="action-button primary-button">

                    @if (string.IsNullOrWhiteSpace(
                                        Model.MapImageUrl))
                    {
                        <span>
                            Upload Basemap
                        </span>
                    }
                    else
                    {
                        <span>
                            Replace Basemap
                        </span>
                    }

                </button>

            </div>

        </form>

        @if (!string.IsNullOrWhiteSpace(
                Model.MapImageUrl))
        {
            <div class="basemap-meta">

                Map image saved.

                @if (Model.MapImageUploadedAt.HasValue)
                {
                    <span>
                        &nbsp; | &nbsp;
                        Uploaded:
                        @(Model.MapImageUploadedAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))
                    </span>
                }

            </div>
        }

        </div>
    </details>

</div>

