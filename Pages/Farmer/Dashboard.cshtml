@page
@model Agriloco1.Pages.Farmer.DashboardModel
@{
    ViewData["Title"] = "Farm Dashboard";
}

<style>
    .dashboard-wrap {
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .dashboard-title {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
    }

    .dashboard-subtitle {
        margin-top: 5px;
        color: #666;
    }

    .dashboard-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .action-button {
        display: inline-block;
        padding: 10px 16px;
        border: 1px solid #999;
        border-radius: 6px;
        background: white;
        color: #222;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
    }

        .action-button:hover {
            background: #f2f2f2;
            color: #111;
        }

    .primary-button {
        background: #222;
        color: white;
        border-color: #222;
    }

        .primary-button:hover {
            background: #444;
            color: white;
        }

    /* ============================================================
           BASEMAP
           ============================================================ */

    .basemap-panel {
        margin-bottom: 24px;
        padding: 18px;
        border: 1px solid #d6d6d6;
        border-radius: 8px;
        background: white;
    }

    .basemap-header {
        margin-bottom: 14px;
    }

        .basemap-header h2 {
            margin: 0 0 4px 0;
            font-size: 20px;
        }

    .basemap-help {
        color: #777;
        font-size: 13px;
    }

    .basemap-preview {
        margin-bottom: 15px;
        padding: 10px;
        border: 1px solid #ddd;
        background: #f7f7f7;
        border-radius: 6px;
        text-align: center;
    }

        .basemap-preview img {
            display: block;
            max-width: 100%;
            max-height: 500px;
            margin: 0 auto;
            object-fit: contain;
        }

    .basemap-empty {
        padding: 45px 20px;
        color: #777;
    }

    .basemap-upload {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .basemap-file {
        padding: 8px;
        border: 1px solid #bbb;
        border-radius: 5px;
        background: white;
    }

    .basemap-meta {
        margin-top: 10px;
        color: #777;
        font-size: 12px;
    }

    .upload-error {
        margin-bottom: 15px;
        padding: 10px 12px;
        border: 1px solid #d9a0a0;
        border-radius: 5px;
        background: #fff5f5;
        color: #900;
    }

    /* ============================================================
           AVAILABILITY CONTROL
           ============================================================ */

    .control-panel {
        border: 1px solid #d6d6d6;
        border-radius: 8px;
        overflow: hidden;
        background: white;
    }

    .control-header {
        display: grid;
        grid-template-columns: minmax(260px, 2fr) minmax(180px, 1fr) minmax(420px, 3fr) 110px;
        gap: 14px;
        padding: 12px 16px;
        background: #f3f3f3;
        border-bottom: 1px solid #d6d6d6;
        font-weight: 700;
    }

    .definition-row {
        display: grid;
        grid-template-columns: minmax(260px, 2fr) minmax(180px, 1fr) minmax(420px, 3fr) 110px;
        gap: 14px;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid #ececec;
    }

        .definition-row:last-child {
            border-bottom: none;
        }

    .definition-name {
        font-weight: 600;
    }

    .definition-type {
        display: block;
        margin-top: 2px;
        font-size: 12px;
        color: #777;
    }

    .status-select {
        width: 100%;
        padding: 7px 8px;
        border: 1px solid #bbb;
        border-radius: 5px;
        background: white;
    }

    .channel-list {
        display: flex;
        flex-wrap: wrap;
        gap: 7px 14px;
    }

    .channel-option {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        font-size: 14px;
    }

    .public-control {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .empty-panel {
        padding: 50px 25px;
        text-align: center;
    }

        .empty-panel h3 {
            margin-bottom: 8px;
        }

        .empty-panel p {
            color: #666;
            margin-bottom: 20px;
        }

    .autosave-note {
        margin-top: 12px;
        color: #777;
        font-size: 13px;
    }

    @@media (max-width: 1000px) {

        .control-header {
            display: none;
        }

        .definition-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .public-control {
            justify-content: flex-start;
        }
    }
</style>

<div class="dashboard-wrap">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="dashboard-header">

        <div>

            <h1 class="dashboard-title">
                @Model.FarmName
            </h1>

            <div class="dashboard-subtitle">
                Availability Control
            </div>

        </div>

        <div class="dashboard-actions">

            <a class="action-button primary-button"
               asp-page="/Farmer/Add"
               asp-route-farmId="@Model.FarmId">
                + Add
            </a>

            <a class="action-button"
               asp-page="/Farmer/Record"
               asp-route-farmId="@Model.FarmId">
                Record Activity
            </a>

            <a class="action-button"
               href="/unity/index.html?farmId=@Model.FarmId">
                Open Map
            </a>

        </div>

    </div>

    <!-- ============================================================
         FARM BASEMAP
         ============================================================ -->

    <div class="basemap-panel">

        <div class="basemap-header">

            <h2>
                Farm Basemap
            </h2>

            <div class="basemap-help">
                Upload an image of the farm that will be used
                as the background for the interactive map.
                JPG, PNG and WebP images are supported.
            </div>

        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="upload-error">

                @foreach (var error
                            in ViewData.ModelState.Values
                            .SelectMany(x => x.Errors))
                {
                    <div>
                        @error.ErrorMessage
                    </div>
                }

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(
                Model.MapImageUrl))
        {
            <div class="basemap-preview">

                <img src="@Model.MapImageUrl"
                     alt="@Model.FarmName basemap" />

            </div>
        }
        else
        {
            <div class="basemap-preview">

                <div class="basemap-empty">
                    No basemap has been uploaded yet.
                </div>

            </div>
        }

        <form method="post"
              enctype="multipart/form-data"
              asp-page-handler="Basemap">

            <input type="hidden"
                   name="farmId"
                   value="@Model.FarmId" />

            <div class="basemap-upload">

                <input class="basemap-file"
                       type="file"
                       asp-for="BasemapUpload"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                <button type="submit"
                        class="action-button primary-button">

                    @if (string.IsNullOrWhiteSpace(
                                        Model.MapImageUrl))
                    {
                        <span>
                            Upload Basemap
                        </span>
                    }
                    else
                    {
                        <span>
                            Replace Basemap
                        </span>
                    }

                </button>

            </div>

        </form>

        @if (!string.IsNullOrWhiteSpace(
                Model.MapImageUrl))
        {
            <div class="basemap-meta">

                Current map:
                @Model.MapImageUrl

                @if (Model.MapImageUploadedAt.HasValue)
                {
                    <span>
                        &nbsp; | &nbsp;
                        Uploaded:
                        @Model.MapImageUploadedAt.Value
                        .ToLocalTime()
                        .ToString("MMM d, yyyy h:mm tt")
                    </span>
                }

            </div>
        }

    </div>

    <!-- ============================================================
         AVAILABILITY CONTROL
         ============================================================ -->

    <div class="control-panel">

        @if (Model.FarmDefinitions.Count == 0)
        {
            <div class="empty-panel">

                <h3>
                    No items have been added yet.
                </h3>

                <p>
                    Build your farm hierarchy,
                    then control availability
                    from this page.
                </p>

                <a class="action-button primary-button"
                   asp-page="/Farmer/Add"
                   asp-route-farmId="@Model.FarmId">
                    + Add First Item
                </a>

            </div>
        }
        else
        {
            <div class="control-header">

                <div>
                    Item
                </div>

                <div>
                    Status
                </div>

                <div>
                    Available Through
                </div>

                <div style="text-align:center;">
                    Public
                </div>

            </div>

            @foreach (var item
                    in Model.FarmDefinitions)
            {
                var depth =
                Model.GetDepth(item);

                var leftPadding =
                8 + (depth * 28);

                <div class="definition-row">

                    <!-- ITEM -->

                    <div style="padding-left:@(leftPadding)px;">

                        <span class="definition-name">

                            @if (depth > 0)
                            {
                                <span>
                                    ↳
                                </span>
                            }

                            @item.DisplayName

                        </span>

                        @if (!string.IsNullOrWhiteSpace(
                                        item.DefinitionType))
                        {
                            <span class="definition-type">
                                @item.DefinitionType
                            </span>
                        }

                    </div>

                    <!-- STATUS -->

                    <div>

                        <form method="post"
                              asp-page-handler="Status">

                            <input type="hidden"
                                   name="farmId"
                                   value="@Model.FarmId" />

                            <input type="hidden"
                                   name="farmDefinitionId"
                                   value="@item.Id" />

                            <select class="status-select"
                                    name="status"
                                    onchange="this.form.submit()">

                                @foreach (var status
                                                        in Model.StatusOptions)
                                {
                                    if (item.Status == status)
                                    {
                                        <option value="@status"
                                                selected>
                                            @status
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@status">
                                            @status
                                        </option>
                                    }
                                }

                            </select>

                        </form>

                    </div>

                    <!-- AVAILABLE THROUGH -->

                    <div class="channel-list">

                        @foreach (var channel
                                        in Model.AvailabilityChannels)
                        {
                            var enabled =
                            Model.IsChannelEnabled(
                            item.Id,
                            channel.Id);

                            <form method="post"
                                  asp-page-handler="Channel"
                                  style="display:inline;">

                                <input type="hidden"
                                       name="farmId"
                                       value="@Model.FarmId" />

                                <input type="hidden"
                                       name="farmDefinitionId"
                                       value="@item.Id" />

                                <input type="hidden"
                                       name="availabilityChannelId"
                                       value="@channel.Id" />

                                <input type="hidden"
                                       name="isEnabled"
                                       value="@(!enabled)" />

                                <label class="channel-option">

                                    <input type="checkbox"
                                           checked="@enabled"
                                           onchange="this.form.submit()" />

                                    @channel.Name

                                </label>

                            </form>
                        }

                    </div>

                    <!-- PUBLIC -->

                    <div class="public-control">

                        <form method="post"
                              asp-page-handler="Public">

                            <input type="hidden"
                                   name="farmId"
                                   value="@Model.FarmId" />

                            <input type="hidden"
                                   name="farmDefinitionId"
                                   value="@item.Id" />

                            <input type="hidden"
                                   name="isPublic"
                                   value="@(!item.IsPublic)" />

                            <input type="checkbox"
                                   checked="@item.IsPublic"
                                   onchange="this.form.submit()" />

                        </form>

                    </div>

                </div>
            }
        }

    </div>

    <div class="autosave-note">
        Availability changes are saved when a
        status or channel is changed.
    </div>

</div>