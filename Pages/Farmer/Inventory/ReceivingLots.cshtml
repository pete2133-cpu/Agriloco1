@page
@model Agriloco1.Pages.Farmer.Inventory.ReceivingLotsModel
@using System.Text.Json

<partial name="_InventoryNav" />
<div class="inventory-page">
<h1>Receiving</h1>

<p>Record inventory coming into the business.</p>

<details class="context-note"><summary>Farm reference</summary><p>@Model.FarmId</p></details>

<form method="get" style="margin-bottom:20px;">
    <input type="hidden" name="FarmId" value="@Model.FarmId" />
    <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search lot, supplier, item, variation, status..." />
    <button type="submit">Search</button>
    <a href="/Farmer/Inventory/ReceivingLots?farmId=@Model.FarmId">Clear</a>
</form>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div style="padding:10px; margin-bottom:15px; border:1px solid red; color:red;">
        @Model.ErrorMessage
    </div>
}

<h2>New Receiving Lot</h2>

<form method="post" asp-page-handler="Create" style="margin-bottom:30px;">
    <input type="hidden" asp-for="FarmId" />
    <section class="harvest-source-card">
        <h3>Where is this delivery from?</h3>
        <label for="harvestSourceMode">Harvest source</label>
        <select asp-for="NewReceiving.SourceMode" id="harvestSourceMode">
            <option value="manual">Supplier delivery without a harvest record</option>
            <option value="own">One of my harvests</option>
            <option value="qr">Scan another farm's harvest</option>
        </select>
        <div id="ownHarvestPanel">
            <label asp-for="NewReceiving.HarvestId">Choose your saved harvest</label>
            <select asp-for="NewReceiving.HarvestId">
                <option value="">Select a harvest...</option>
                @foreach (var harvest in Model.HarvestOptions)
                {
                    <option value="@harvest.Id">@harvest.LotNumber · @harvest.CropName / @harvest.VarietyName · @harvest.Location · @harvest.HarvestDate.ToString("yyyy-MM-dd") · @harvest.Quantity @harvest.Unit</option>
                }
            </select>
            @if (!Model.HarvestOptions.Any()) { <p>No harvests saved for this farm yet. Record a harvest first, or use a supplier delivery.</p> }
        </div>
        <div id="qrHarvestPanel">
            <p>Scan an Agriloco harvest label from a screen or paper, or upload its QR image. Details stay on this device until you record the delivery.</p>
            <button type="button" id="startHarvestCamera">Scan with camera</button>
            <button type="button" id="stopHarvestCamera" hidden>Stop camera</button>
            <label for="harvestQrFile">Upload QR image</label>
            <input type="file" id="harvestQrFile" accept="image/*" />
            <video id="harvestVideo" playsinline muted hidden></video>
            <p id="harvestScanStatus" role="status" aria-live="polite"></p>
            <label asp-for="NewReceiving.HarvestPayload">Harvest transfer text (scanner or paste)</label>
            <textarea asp-for="NewReceiving.HarvestPayload" rows="3" maxlength="2000"></textarea>
            <p id="harvestSourcePreview"></p>
            <p>Review the farm-supplied details before saving. QR contents are not independently verified.</p>
        </div>
        <p>Choose the matching inventory item below and enter only the amount received in this delivery. The original harvest quantity is kept as source information; recording a receipt does not reduce the harvest.</p>
    </section>

    <div>
        <label>Received Date</label><br />
        <input asp-for="NewReceiving.ReceivedDate" type="date" required />
    </div>

    <br />

    <div>
        <label>Supplier</label><br />
        <input asp-for="NewReceiving.SupplierSearch"
               list="supplierList"
               placeholder="Start typing supplier..."
               style="width:450px;" />
        <small>Required for a supplier delivery. With a harvest source, leave blank to use its farm name, or select your supplier record.</small>

        <datalist id="supplierList">
            @foreach (var supplier in Model.SupplierOptions)
            {
                <option value="@supplier.Id | @supplier.Name"></option>
            }
        </datalist>
    </div>

    <br />

    <div>
        <label>Item</label><br />
        <input asp-for="NewReceiving.ItemSearch"
               id="itemSearchBox"
               list="itemList"
               placeholder="Start typing item..."
               style="width:500px;"
               required />

        <datalist id="itemList">
            @foreach (var item in Model.InventoryItemOptions)
            {
                <option value="@item.ItemId | @item.DisplayName"></option>
            }
        </datalist>
    </div>

    <br />

    <div>
        <label>Item Variation / Package <small>(optional)</small></label><br />
        <input asp-for="NewReceiving.ItemVariationSearch"
               id="variationSearchBox"
               list="itemVariationList"
               placeholder="Optional: select package variation..."
               style="width:600px;" />

        <datalist id="itemVariationList">
        </datalist>

        <br />
        <small>If no variation is selected, the quantity is received directly in the item’s base unit.</small>
    </div>

    <br />

    <div>
        <label>Number of Units Received</label><br />
        <input asp-for="NewReceiving.UnitsReceived" type="number" step="0.01" required />
    </div>

    <br />

    <button type="submit">Record delivery</button>
</form>

<h2>Received Inventory</h2>

<table border="1" cellpadding="8" cellspacing="0" style="width:100%; border-collapse:collapse;">
    <thead>
        <tr>
            <th>Lot #</th>
            <th>Date</th>
            <th>Supplier</th>
            <th>Item</th>
            <th>Variation</th>
            <th>Specifications</th>
            <th>Units Received</th>
            <th>Usable Per Unit</th>
            <th>Total Usable</th>
            <th>Location</th>
            <th>Status</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.ReceivingLots.Any())
        {
            <tr>
                <td colspan="12">No receiving lots found.</td>
            </tr>
        }
        else
        {
            @foreach (var lot in Model.ReceivingLots)
            {
                <tr>
                    <td>@lot.LotNumber</td>
                    <td>@lot.ReceivedDate.ToString("yyyy-MM-dd")</td>
                    <td>@lot.SupplierName</td>
                    <td>@lot.InventoryItemName</td>
                    <td>@lot.VariationName</td>

                    <td>
                        @if (Model.CustomDetailsByLotId.ContainsKey(lot.Id))
                        {
                            @Html.Raw(Model.CustomDetailsByLotId[lot.Id])
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>

                    <td>@lot.UnitsReceived</td>
                    <td>@lot.UsableQuantityPerUnit @lot.UsableUnit</td>
                    <td><strong>@lot.TotalUsableQuantity @lot.UsableUnit</strong></td>
                    <td>@(string.IsNullOrWhiteSpace(lot.StorageLocation) ? "-" : lot.StorageLocation)</td>
                    <td>@lot.Status</td>
                    <td>
                        <a href="/Farmer/Inventory/ReceivingLotDetails?id=@lot.Id&farmId=@Model.FarmId">Details</a>

                        <form method="post" asp-page-handler="Delete" style="display:inline; margin-left:8px;"
                              onsubmit="return confirm('Delete this receiving lot?');">
                            <input type="hidden" name="id" value="@lot.Id" />
                            <input type="hidden" name="farmId" value="@Model.FarmId" />
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    const allVariations = @Html.Raw(JsonSerializer.Serialize(
                Model.ItemVariationOptions.Select(v => new
                {
                        itemId = v.ItemId,
                        value = $"{v.PackageId} | {v.DisplayName}"
                })
        ));

    function getLeadingId(value) {
        if (!value || !value.includes("|")) return null;
        const firstPart = value.split("|")[0].trim();
        const parsed = parseInt(firstPart);
        return Number.isNaN(parsed) ? null : parsed;
    }

    function refreshVariationList() {
        const itemBox = document.getElementById("itemSearchBox");
        const variationBox = document.getElementById("variationSearchBox");
        const variationList = document.getElementById("itemVariationList");

        const itemId = getLeadingId(itemBox.value);

        variationBox.value = "";
        variationList.innerHTML = "";

        if (!itemId) return;

        const filtered = allVariations.filter(v => v.itemId === itemId);

        filtered.forEach(v => {
            const option = document.createElement("option");
            option.value = v.value;
            variationList.appendChild(option);
        });
    }

    document.getElementById("itemSearchBox").addEventListener("change", refreshVariationList);
    document.getElementById("itemSearchBox").addEventListener("input", refreshVariationList);
</script>
</div>

<script src="~/lib/jsqr/jsQR.js" asp-append-version="true"></script>
<script src="~/js/receiving-harvest.js" asp-append-version="true"></script>
