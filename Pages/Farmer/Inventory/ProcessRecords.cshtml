@page
@model Agriloco1.Pages.Farmer.Inventory.ProcessRecordsModel
@{ ViewData["Title"] = "Record an activity"; var farmId = int.TryParse(Request.Query["farmId"], out var f) && f > 0 ? f : 1; }
<partial name="_InventoryNav" />
<div class="inventory-page">
<h1>Record an activity</h1><p class="section-intro">Choose the type of work you want to record. Existing records are available on each page.</p><div class="tool-grid"><a class="tool-card" asp-page="HarvestLots" asp-route-farmId="@farmId"><h2>Harvests</h2><p>Keep harvest quantities and lot details together.</p></a><a class="tool-card" asp-page="ReceivingLots" asp-route-farmId="@farmId"><h2>Receiving</h2><p>Record incoming quantities and supplier details.</p></a><a class="tool-card" asp-page="ProductionRuns" asp-route-farmId="@farmId"><h2>Production</h2><p>Start a batch and review production progress.</p></a></div>
</div>
